[sub_resource type="GDScript" id="GDScript_m7lay"]
script/source = "extends Camera3D

# THIS SCRIPT MOSTLY MANAGES CAMERA ROTATION
# IF YOU WANT TO SEE HOW TO USE HKNOXEL, LOOK AT LINE 47 <----------------

var speed: float = 1
var is_resetting: bool = false
var reset_progress: float = 0.0
var reset_start_position: Vector3
var reset_start_rotation_y: float

const RESET_DURATION: float = 0.35
const RESET_POSITION := Vector3(-11.3, 16.59, 0.0)
const RESET_ROTATION_Y: float = 0.0

func _physics_process(delta: float) -> void:
	$VBoxContainer.scale = Vector2(1, 1) * (float(get_window().content_scale_size.y)/648)
	
	if is_resetting:
		reset_progress = minf(reset_progress + delta / RESET_DURATION, 1.0)
		var weight := smoothstep(0.0, 1.0, reset_progress)
		position = reset_start_position.lerp(RESET_POSITION, weight)
		$\"..\".rotation.y = lerp_angle(reset_start_rotation_y, RESET_ROTATION_Y, weight)
		look_at(Vector3.ZERO)
		if reset_progress >= 1.0:
			is_resetting = false
		return
	
	if Input.is_action_pressed(\"ui_up\"):
		position.x += speed*5 * delta
	if Input.is_action_pressed(\"ui_left\"):
		$\"..\".rotation.y -= speed*1 * delta
	if Input.is_action_pressed(\"ui_right\"):
		$\"..\".rotation.y += speed*1 * delta
	if Input.is_action_pressed(\"ui_down\"):
		position.x -= speed*5 * delta
	if Input.is_action_pressed(\"ui_accept\"):
		position.y -= speed*5 * delta
	if Input.is_action_pressed(\"ui_cancel\"):
		position.y += speed*5 * delta
	
	if Input.is_action_just_pressed(\"ui_undo\"):
		is_resetting = true
		reset_progress = 0.0
		reset_start_position = position
		reset_start_rotation_y = $\"..\".rotation.y
	if Input.is_action_just_pressed(\"ui_redo\"): # THIS SPAWNS A SOUND!!!!!
		if not HKNoxelEmitterID:
			HKNoxelEmitterID = HKNoxelManager.register_source(self)
		HKNoxelManager.emitSound(Vector3(0, 1.5, 0), 5, HKNoxelEmitterID) # the \"decibels\" are way out of proportion, being way louder
	
	look_at(Vector3.ZERO)

var HKNoxelEmitterID
"

